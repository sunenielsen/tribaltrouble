# Copy to /etc/bugserver.env (chmod 600, owned by root) and fill in.
# Plane root URL, as reachable from the bug server box.
BUGSERVER_PLANE_URL=https://plane.example.org
# Workspace settings > API tokens.
BUGSERVER_PLANE_API_KEY=
# The slug in Plane URLs: https://<plane>/<workspace>/projects/<project-id>/...
BUGSERVER_PLANE_WORKSPACE=
BUGSERVER_PLANE_PROJECT=
# Optional: comma-separated label UUIDs to put on every crash work item (e.g. a "crash" label).
BUGSERVER_PLANE_LABELS=
# urgent, high, medium, low or none.
BUGSERVER_PLANE_PRIORITY=high
# "work-items" on current Plane; set to "issues" on older self-hosted versions without the work-items API.
BUGSERVER_PLANE_ITEMS_PATH=work-items
